{
  "name": "dsh-bgm-prep",
  "version": "0.7.1",
  "private": true,
  "description": "跑团备团配乐：把场景清单变成带标签的曲目表，导出可粘贴歌单清单 · TRPG session-prep BGM cue sheets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengnowuyu-beep/dsh-bgm-prep.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "scripts",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test",
    "setup": "node scripts/setup.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "trpg",
    "bgm",
    "netease",
    "playlist"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
